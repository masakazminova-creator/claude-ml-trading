# Claude ML Trading System - Example Configuration
# Copy this file to .env and edit the values

# === Market Data ===
MARKET_DATA_PROVIDER=okx
BYBIT_BASE_URL=https://api.bybit.com
OKX_BASE_URL=https://www.okx.com

# === Multi-Symbol (comma-separated) ===
SYMBOLS=BTCUSDT
MARKET_CATEGORY=linear
TIMEFRAME=15

# === Data Collection ===
LOOKBACK_BARS=3000
TRAINING_LOOKBACK_BARS=10000
TRAIN_SPLIT=0.8

# === Feature Engineering ===
LABEL_HORIZON_BARS=6
LABEL_MIN_RETURN_PCT=0.35
ATR_PERIOD=14
RSI_PERIOD=14
EMA_FAST=8
EMA_SLOW=21

# === Model Configuration ===
MODEL_MAX_DEPTH=5
MODEL_LEARNING_RATE=0.045
MODEL_MAX_ITER=300
MODEL_MIN_SAMPLES_LEAF=20
MODEL_RANDOM_STATE=42

# === Entry Thresholds ===
EARLY_SIGNAL_THRESHOLD=0.60
CONFIRMATION_THRESHOLD=0.75
MOMENTUM_THRESHOLD=0.55

# === Risk Management ===
RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_RISK_PCT=5.0
MAX_DRAWDOWN_PCT=15.0
REDUCE_SIZE_AT_DD_PCT=10.0
PAUSE_AT_DD_PCT=12.0
MAX_POSITION_SIZE_PCT=3.0

# === Position Sizing Multipliers ===
SIZE_MULTIPLIER_CHOP=0.5
SIZE_MULTIPLIER_EXPANSION=1.2
SIZE_MULTIPLIER_TREND=1.0

# === Exit Configuration ===
MIN_ATR_PCT_FOR_ENTRY=0.5  # Minimum ATR% required to enter trades (prevents low-volatility trades)
TAKE_PROFIT_ATR_MULTIPLIER=2.5
STOP_LOSS_ATR_MULTIPLIER=2.0
TRAILING_TRIGGER_ATR_MULTIPLIER=0.5
TRAILING_STEP_ATR_MULTIPLIER=1.0
SOFT_EXIT_ENABLED=true
SOFT_EXIT_MIN_BARS=2

# === Continuous Learning ===
RETRAIN_INTERVAL_TRADES=100
DRIFT_CHECK_CORRELATION_THRESHOLD=0.3
MIN_TRADES_FOR_CALIBRATION=50
WALK_FORWARD_FOLDS=5

# === Runtime ===
POLL_SECONDS=15
MODE=paper
PAPER_START_BALANCE=10000
LEVERAGE=1

# === Costs ===
FEE_BPS=5.0
SLIPPAGE_BPS=3.0

# === Health Checks ===
STALE_CANDLE_GRACE_MINUTES=5
MAX_ERROR_STREAK=3
DAILY_PNL_LIMIT_PCT=5.0

# === Notifications ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Blocked Conditions (comma-separated, optional) ===
BLOCKED_REGIMES=chop,dead_chop
BLOCKED_HOURS_MSK=02,03,14
